{
  "entities": {
    "UserProgress": {
      "title": "UserProgress",
      "description": "Progres belajar sains, XP, level, materi selesai, kuis, simulasi, dan status PRO pengguna.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "namaAlias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "isPro": {
          "type": "boolean"
        },
        "proPlanName": {
          "type": "string",
          "maxLength": 80
        },
        "xp": {
          "type": "number"
        },
        "level": {
          "type": "number"
        },
        "totalPoin": {
          "type": "number"
        },
        "badge": {
          "type": "array"
        },
        "materiSelesai": {
          "type": "array"
        },
        "kuisSelesai": {
          "type": "array"
        },
        "simulasiDicoba": {
          "type": "array"
        },
        "dailyChallenge": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "namaAlias",
        "isPro",
        "xp",
        "level",
        "totalPoin",
        "badge",
        "materiSelesai",
        "kuisSelesai",
        "simulasiDicoba",
        "dailyChallenge",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Informasi PII privat pengguna (email dan penyedia autentikasi) yang terisolasi dari dokumen progres.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "authProvider": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "email", "authProvider", "createdAt", "updatedAt"]
    },
    "ProTransaction": {
      "title": "ProTransaction",
      "description": "Catatan struk transaksi simulasi langganan DoodleLab PRO milik pengguna.",
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "enum": ["monthly", "yearly", "lifetime"]
        },
        "planName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subtotal": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "adminFee": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["LUNAS (Paid)"]
        },
        "paidAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "invoiceId",
        "userId",
        "planId",
        "planName",
        "subtotal",
        "discount",
        "adminFee",
        "total",
        "method",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "Dokumen progres belajar dan gamifikasi milik pengguna."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Subkoleksi terisolasi untuk data PII email pengguna."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/ProTransaction" },
      "description": "Subkoleksi riwayat transaksi langganan DoodleLab PRO milik pengguna."
    }
  }
}
